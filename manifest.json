{
  "manifest_version": 3,
  "name": "FreeMedium",
  "version": "1.1",
  "description": "An extension to read Medium posts for free.",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/shared-constants.js",
        "src/medium-page-detection.js",
        "src/freedium-connection.js",
        "src/overlay-ui.js",
        "src/content.js"
      ],
      "css": ["styles/overlay.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://medium.com/*", "https://*.medium.com/*"],
      "js": ["src/medium-history-hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://freedium-mirror.cfd/*"],
      "js": ["src/freedium-frame.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
